# 🛡️ Webhook安全配置文件
# 复制到.env文件中使用

# 基础配置
PORT=3001
NESTJS_URL=http://localhost:3000

# 🔐 Token配置（建议使用强密码生成器）
VALID_TOKENS=wechat_prod_a7b9x2k8,wechat_dev_m3n5p1q4,backup_token_z8y6w4v2

# 🛡️ IP白名单配置（推荐）
# 微信服务器IP段（示例，请查询微信官方最新IP）
ALLOWED_IPS=101.226.103.0/24,101.226.233.0/24,140.207.54.0/24,你的办公室IP,你的家庭IP

# 🌐 域名白名单配置（可选）
# 只允许来自指定域名的请求
ALLOWED_DOMAINS=wechat.qq.com,api.weixin.qq.com,你的域名.com

# ⚡ 请求频率限制
RATE_LIMIT_WINDOW=60000   # 时间窗口(毫秒) - 60秒
RATE_LIMIT_MAX=20         # 最大请求数 - 每分钟20次