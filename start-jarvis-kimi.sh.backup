#!/bin/bash
# 启动 Jarvis-Kimi 模式 - 使用 Kimi AI 引擎，但加载 Jarvis(Claude) 的人设
# 角色: 全栈开发工程师
# 用法: ./start-jarvis-kimi.sh

cd "$(dirname "$0")"

echo "=========================================="
echo "  启动 Jarvis-Kimi 模式"
echo "  AI引擎: Kimi (Moonshot AI)"
echo "  人设来源: jarvis/CLAUDE.md"
echo "  角色: 全栈开发工程师"
echo "=========================================="
echo ""

# 检查 jarvis 目录是否存在
if [ ! -d "./jarvis" ]; then
    echo "❌ 错误: jarvis 目录不存在"
    exit 1
fi

# 进入 jarvis 目录（Kimi 将在这里工作，读取 CLAUDE.md 等人设）
cd "./jarvis"

echo "✅ 工作目录: $(pwd)"
echo ""

# 检查并显示已加载的人设文档
echo "📄 已加载的人设文档:"
[ -f "./CLAUDE.md" ] && echo "   ✅ CLAUDE.md - 核心人设（Claude版）"
[ -f "./PERSONA.md" ] && echo "   ✅ PERSONA.md - 基础人设"
[ -d "./skills" ] && echo "   ✅ skills/ - 技能目录 ($(ls ./skills 2>/dev/null | wc -l) 个技能)"

echo ""
echo "💡 提示: Kimi 将使用 Jarvis(Claude) 的开发人设和技能"
echo "💡 与 ./start-jarvis.sh 的区别: AI引擎不同，人设相同"
echo ""

# ==========================================
# 会话继承选择
# ==========================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  🔄 会话继承选项"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  1) 🆕 新建会话 (默认)"
echo "  2) 📜 继续最近会话 (--continue)"
echo "  3) 📋 列出所有会话 (--list-sessions)"
echo ""
read -p "请选择 [1-3] (默认: 1): " choice
echo ""

# 处理用户选择
SESSION_OPTION=""
case "$choice" in
    2)
        echo "✅ 已选择: 继续最近会话"
        SESSION_OPTION="--continue"
        ;;
    3)
        echo "📋 正在列出所有可用会话..."
        echo ""
        kimi --list-sessions
        echo ""
        read -p "请输入要恢复的会话 ID (直接回车新建会话): " session_id
        if [ -n "$session_id" ]; then
            SESSION_OPTION="--session $session_id"
            echo "✅ 已选择: 恢复会话 $session_id"
        else
            echo "✅ 已选择: 新建会话"
        fi
        ;;
    *)
        echo "✅ 已选择: 新建会话"
        SESSION_OPTION=""
        ;;
esac

echo ""
echo "正在启动 Kimi..."
echo ""

# 启动 Kimi，工作目录设为 jarvis/
if [ -n "$SESSION_OPTION" ]; then
    kimi --work-dir . $SESSION_OPTION
else
    kimi --work-dir .
fi
